 "font_size": 14,
 "html": "\r\n\r\n    <div style=\"font-family: Arial, sans-serif;\">\r\n\r\n    <!-- Section for Each Item -->\r\n    {% for item in doc.items %}\r\n    <div style=\"border: 4px solid black; border-radius:10px; padding:5px; margin-bottom:50px\">\r\n        <div style=\"border: 3px dashed #333; border-radius:5px; padding: 15px;\">\r\n            \r\n            <!-- Item Header -->\r\n            <div style=\"display: flex; align-items: center; margin-bottom: 10px;\">\r\n                <div>\r\n                    {% if frappe.db.get_value(\"Item\", item.item_code, \"image\") %}\r\n                        <img src=\"{{ frappe.db.get_value('Item', item.item_code, 'image') }}\" alt=\"Item Image\"\r\n                            style=\"width: 160px; height: 160px;\">\r\n                    {% else %}\r\n                        <p>No Image</p>\r\n                    {% endif %}\r\n                </div>\r\n                \r\n                <div style=\"flex: 1; margin-left:10px\">\r\n                    <h3 style=\"margin: 0; font-size:28;\">{{ item.item_code }}</h3>\r\n                    <p style=\"margin: 0; font-size:24\">{{ item.item_name }}</p>\r\n                </div>\r\n            </div>\r\n            \r\n            <div style=\"width:100%; height:2px; background-color:black;\"></div>\r\n            <div style=\"width:100%; margin-top:3px; margin-bottom:15px height:1px; background-color:black;\"></div>\r\n    \r\n            <div style=\"display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;\">\r\n                <div>\r\n                    <p style=\"font-size:42px; font-weight:bold;\"> {{ item.name }}</p>\r\n                    <p style=\"font-size:24;\"> {{ frappe.format_date(doc.posting_date, \"dd.MM.yyyy\") }}</p>\r\n                    <div style=\"display:flex;\">\r\n                        <div style=\"background-color:black; padding:10px; border-radius:5px\">\r\n                           <p style=\"font-size:24; color:white\"> {{ item.qty }} / {{ item.uom }}</p>  \r\n                        </div>\r\n                        <div style=\"padding:10px;\">\r\n                            <p style=\"font-size:24; margin-left:25px;\"> QC: {{ doc.qc_by }} </p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    \r\n               <div>\r\n                    {% if frappe.db.get_value(\"Item\", item.item_code, \"image\") %}\r\n                        <img src=\"{{ frappe.db.get_value('Item', item.item_code, 'image') }}\" alt=\"Item Image\"\r\n                            style=\"width: 200px; height: 200px;\">\r\n                    {% else %}\r\n                        <p>No Image</p>\r\n                    {% endif %}\r\n                </div>\r\n                \r\n    \r\n            <!-- QR Code -->\r\n            <div style=\"text-align: right;\">\r\n               \r\n            </div>\r\n        </div>\r\n        \r\n    </div>\r\n    {% endfor %}\r\n</div>\r\n\r\n",
