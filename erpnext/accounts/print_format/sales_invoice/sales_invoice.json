 "css": ".info{\n    display:flex;\n    font-size:12;\n}\n\n.info>div{\n    flex:1;\n}\n\n\n.info-detail tr{\n    background-color:#ccc;\n    border-bottom : 10px solid white;\n    font-size:12;\n}\n\n.delivery-detail>table{\n    width:62%;\n    border-top:5px solid #ccc;  \n    font-size:12px;\n}\n\n.item-detail>table{\n     font-size:12px;\n     width:100%;\n}\n\n.item-detail thead{\n     background-color:#ccc;\n}\n\n.total>table{\n    width:50%;\n    font-size:12px;\n}\n\n.total{\n    display:flex;\n    align-items:flex-end;\n    justify-content:flex-end;\n    margin-top:30px;\n}\n\n.total td:last-child{\n    text-align:right;\n}\n\n.total tr:last-child{\n    background-color:#ccc;\n}\n\n",
