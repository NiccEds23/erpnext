 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<body>\n    <header>\n      <div style=\"text-align: center;\">\n        <img src=\"/files/KOP New Transparent.png\" style=\"width: 100%; max-height: 150px;\">\n      </div>\n    </header>\n    <section class=\"info\">\n        <div class=\"penagihan\">\n            <p>ALAMAT PENAGIHAN</p>\n            <p>{{doc.customer}}</p>\n            <p>{{doc.customer_address}}</p>\n        </div>\n        <div class=\"pengiriman\">\n            <p>ALAMAT PENGIRIMAN</p>\n            <p>{{doc.customer}}</p>\n            <p>{{doc.shipping_address_name}}</p>\n        </div>\n        <div class=\"info-detail\">\n            <table>\n                <tr>\n                    <td class=\"\">FAKTUR</td>\n                    <td class=\"\">{{doc.name}}</td>\n                </tr>\n                <tr>\n                    <td class=\"\">TANGGAL</td>\n                    <td class=\"\">{{doc.posting_date}}</td>\n                </tr>\n                <tr>\n                    <td class=\"\">TERMS</td>\n                    <td class=\"\">{{doc.payment_terms_template}}</td>\n                </tr>\n                <tr>\n                    <td class=\"\">JATUH TEMPO</td>\n                    <td class=\"\">{{doc.due_date}}</td>\n                </tr>\n            </table>\n        </div>\n    </section>\n    \n    <section class=\"delivery-detail\">\n        <table>\n            <tr>\n                <td>TGL PENGIRIMAN</td>\n                <td>CARA PENGIRIMAN</td>\n                <td>TRACKING NO</td>\n            </tr>\n            <tr>\n                <td>{{doc.due_date}}</td>\n                <td></td>\n                <td></td>\n            </tr>\n        </table>\n    </section>\n    \n    <section class=\"item-detail\">\n        <table>\n            <thead>\n                <tr>\n                    <th>Item</th>\n                    <th>Qty</th>\n                    <th>Diskon</th>\n                    <th>Harga</th>\n                    <th>Jumlah</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.items %}\n                    <tr>\n                      <td>{{ item.item_name }}</td>\n                      <td>{{ item.qty }} {{ item.uom }}</td>\n                      <td>{{ item.qty }} {{ item.discount_percentage }}</td>\n                      <td>{{ item.get_formatted(\"rate\") }}</td>\n                      <td>{{ item.get_formatted(\"amount\") }}</td>\n                    </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </section>\n    \n    <section class=\"total\">\n        <table>\n             <tr>\n                <td class=\"\">SUBTOTAL</td>\n                <td class=\"\">{{doc.get_formatted(\"net_total\")}}</td>\n            </tr>\n            <!--<tr>-->\n            <!--    <td class=\"\">Diskon per Item</td>-->\n            <!--    <td class=\"\">{{doc.get_formatted(\"total_taxes_and_charges\")}}</td>-->\n            <!--</tr>-->\n            <tr>\n                <td class=\"\">Termasuk PPN 11.0%</td>\n                <td class=\"\">{{doc.get_formatted(\"total_taxes_and_charges\")}}</td>\n            </tr>\n            <tr>\n                <td class=\"\">TOTAL</td>\n                <td class=\"\">{{doc.get_formatted(\"grand_total\")}}</td>\n            </tr>\n            <tr>\n                <td class=\"\">SISA TAGIHAN</td>\n                <td class=\"\">{{doc.get_formatted(\"outstanding_amount\")}}</td>\n            </tr>\n        </table>\n    </section>\n</body>",
